# 默认预演且所有动作需人工审批。填写白名单并完成控件校准后才能操作。
DRY_RUN=true
REQUIRE_APPROVAL=true
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
SELF_NAME=胡锦程
# 不被@时，仅这些话题进入群聊参与度判断；留空表示只响应@
GROUP_TOPICS=
COOLDOWN_SECONDS=30
POLL_SECONDS=3
APPROVAL_TTL_SECONDS=300
DATABASE_PATH=data/mywechat.sqlite3
STOP_FILE=data/STOP
